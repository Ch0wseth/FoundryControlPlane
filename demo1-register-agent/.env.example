# Demo 1 - Environment Variables
# Copy this file to .env and fill in your values

# Azure OpenAI (from your Foundry project deployment)
AZURE_OPENAI_ENDPOINT=https://chowseth-aiproj-1-resource.openai.azure.com/
AZURE_OPENAI_KEY=<your-key-here>
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Application Insights (for OpenTelemetry export)
APPLICATIONINSIGHTS_CONNECTION_STRING=<your-connection-string>

# Agent Configuration
AGENT_ID=jedi-council-agent
PORT=8000
